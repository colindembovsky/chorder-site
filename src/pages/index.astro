---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Screenshots from '../components/Screenshots.astro';
import PrivacyBand from '../components/PrivacyBand.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import BetaSignup from '../components/BetaSignup.astro';
import { BETA_SIGNUP_ACTIVE } from '../lib/constants';
---
<Base>
  <Hero />
  <FeatureGrid />
  <div class="container-x"><div class="staff-divider" aria-hidden="true"></div></div>
  <Screenshots />
  <HowItWorks />
  <PrivacyBand />
  <FAQSection />
  {BETA_SIGNUP_ACTIVE && <BetaSignup />}
  <FinalCTA />
</Base>
