---
import { APP_NAME, TALLY_FORM_ID } from '../lib/constants';

const tallySrc = `https://tally.so/embed/${TALLY_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---
<section id="beta" class="band" aria-labelledby="beta-h">
  <div class="container-x grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-12 items-center">
    <div>
      <h2 id="beta-h" class="h-section">Try {APP_NAME} in the beta.</h2>
      <p class="lede mt-5">
        Drop your email and we&rsquo;ll invite you. We only use it to send {APP_NAME} beta updates, and you can unsubscribe any time. See our
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy`} class="link">Privacy Policy</a>.
      </p>
    </div>

    <div class="rounded-xl border border-border p-2 sm:p-4" style="background: rgb(var(--surface));">
      <iframe
        data-tally-src={tallySrc}
        loading="lazy"
        width="100%"
        height="262"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title={`Sign up for the ${APP_NAME} beta`}
      ></iframe>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var iframe = document.querySelector('#beta iframe[data-tally-src]');
    if (!iframe) return;

    // Load Tally's widget, which sets the iframe src and handles dynamicHeight.
    var w = 'https://tally.so/widgets/embed.js';
    var setIframeSrc = function () {
      iframe.src = iframe.dataset.tallySrc;
    };
    var load = function () {
      if (typeof Tally !== 'undefined') {
        Tally.loadEmbeds();
        if (!iframe.hasAttribute('src')) setIframeSrc();
        return;
      }
      document
        .querySelectorAll('iframe[data-tally-src]:not([src])')
        .forEach(function (e) {
          e.src = e.dataset.tallySrc;
        });
    };

    // Tally embeds follow the host's CSS `color-scheme`, but the form only
    // appears to resolve that preference when the iframe loads. Set the scheme
    // before first load, then reload the iframe when visitors toggle themes.
    var activeScheme;
    function getScheme() {
      return document.documentElement.getAttribute('data-theme') === 'light'
        ? 'light'
        : 'dark';
    }
    function syncScheme() {
      activeScheme = getScheme();
      iframe.style.colorScheme = activeScheme;
    }
    function reloadForThemeChange() {
      var nextScheme = getScheme();
      if (nextScheme === activeScheme) return;
      activeScheme = nextScheme;
      iframe.style.colorScheme = nextScheme;
      if (!iframe.hasAttribute('src')) return;

      iframe.removeAttribute('src');
      window.requestAnimationFrame(function () {
        setIframeSrc();
        if (typeof Tally !== 'undefined') Tally.loadEmbeds();
      });
    }

    syncScheme();

    new MutationObserver(reloadForThemeChange).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    if (typeof Tally !== 'undefined') {
      load();
    } else if (document.querySelector('script[src="' + w + '"]') == null) {
      var s = document.createElement('script');
      s.src = w;
      s.onload = load;
      s.onerror = load;
      document.body.appendChild(s);
    }
  })();
</script>
