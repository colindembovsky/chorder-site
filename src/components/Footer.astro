---
import { APP_NAME, PUBLISHER, SUPPORT_EMAIL, COPYRIGHT_YEAR } from '../lib/constants';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteRoot = base ? `${base}/` : '/';
const sectionHref = (hash: string) => `${siteRoot}${hash}`;
---
<footer class="border-t border-border py-12 text-[0.9375rem]" style="background: rgb(var(--surface));">
  <div class="container-x grid grid-cols-1 gap-10 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <img src={`${base}/images/logo.png`} alt="" width="32" height="32" class="h-8 w-8 rounded-lg object-cover" loading="lazy" decoding="async" />
        <span class="font-extrabold text-lg">{APP_NAME}</span>
      </div>
      <p class="mt-3 text-muted max-w-xs">Chord charts and setlists for Android tablets. Built by {PUBLISHER}.</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-bold text-muted mb-1">Site</h2>
      <ul class="list-none p-0 m-0">
        <li><a href={`${base}/`} class="nav-link">Home</a></li>
        <li><a href={sectionHref('#features')} class="nav-link">Features</a></li>
        <li><a href={sectionHref('#faq')} class="nav-link">FAQ</a></li>
        <li><a href={`${base}/privacy`} class="nav-link">Privacy policy</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-bold text-muted mb-1">Contact</h2>
      <a href={`mailto:${SUPPORT_EMAIL}`} class="nav-link break-all">{SUPPORT_EMAIL}</a>
    </div>
  </div>

  <div class="container-x mt-10 pt-6 border-t border-border text-sm text-muted flex flex-wrap gap-3 justify-between items-center">
    <p>&copy; {COPYRIGHT_YEAR} {PUBLISHER}. All rights reserved.</p>
    <p>Google Play and the Google Play logo are trademarks of Google LLC.</p>
  </div>
</footer>
