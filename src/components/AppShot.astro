---
import { SHOTS, type ShotId } from '../content/screenshots';

interface Props {
  id: ShotId;
  /** `auto` renders both themes and shows the one matching the site theme. */
  theme?: 'auto' | 'light' | 'dark';
  sizes?: string;
  eager?: boolean;
  caption?: string;
  /** Wrap in the tablet bezel. Turn off for cropped panels. */
  framed?: boolean;
  class?: string;
}

const { id, theme = 'auto', sizes = '(min-width: 1024px) 56vw, 100vw', eager = false, caption, framed = true, class: cls = '' } = Astro.props;
const shot = SHOTS[id];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const themes = theme === 'auto' ? (['light', 'dark'] as const) : ([theme] as const);
const src = (t: string, w: number) => `${base}/images/app/${id}-${t}-${w}.webp`;
---
<figure class={cls}>
  <div class={framed ? 'device' : 'device device--bare'}>
    {themes.map((t) => (
      <img
        class={theme === 'auto' ? `shot-${t}` : undefined}
        src={src(t, 1600)}
        srcset={`${src(t, 800)} 800w, ${src(t, 1600)} 1600w`}
        sizes={sizes}
        width={shot.width}
        height={shot.height}
        alt={shot.alt}
        loading={eager ? undefined : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    ))}
  </div>
  {caption && <figcaption class="shot-caption">{caption}</figcaption>}
</figure>
