---
import { APP_NAME, APP_SUBHEAD, PLAY_LIVE, PLAY_URL, BETA_SIGNUP_ACTIVE } from '../lib/constants';
import AppShot from './AppShot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{/*
  THESIS: A calm lead sheet on a music stand. The page opens on the real Performance view
  and answers one question first: what do I play?
  TYPE: Atkinson Hyperlegible Next only. Heavy display, regular body.
  COLOUR: slate chrome; brass only for the key, the Play block and the primary action.
  LAYOUT: flat sections with hairlines; screenshots in a tablet frame; no card grids.
  MOTION: hero settles in once; reduced motion removes it.
*/}
<section class="pt-12 pb-14 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24">
  <div class="container-x grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 items-center">
    <div class="rise">
      <h1 class="h-display">Know what to play before the count-in.</h1>
      <p class="lede mt-6">{APP_SUBHEAD}</p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        {PLAY_LIVE ? (
          <a href={PLAY_URL} aria-label={`Get ${APP_NAME} on Google Play`} class="inline-block">
            <img src={`${base}/images/google-play-badge.svg`} alt="Get it on Google Play" height="60" width="202" class="h-14 w-auto" />
          </a>
        ) : BETA_SIGNUP_ACTIVE ? (
          <a href="#beta" class="btn btn-brass">Join the beta</a>
        ) : (
          <span class="btn btn-status">Coming soon to Google Play</span>
        )}
        <a href="#features" class="btn btn-quiet">See how it works</a>
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem] text-muted list-none p-0">
        <li>Android 8.0 and newer</li>
        <li>No account</li>
        <li>No ads or analytics</li>
      </ul>
    </div>

    <AppShot
      id="performance-single"
      eager
      sizes="(min-width: 1024px) 58vw, 100vw"
      class="rise rise-2"
    />
  </div>
</section>
