---
import { APP_NAME, PLAY_LIVE, PLAY_URL } from '../lib/constants';
import MobileNav from '../islands/MobileNav.svelte';
import ThemeToggle from '../islands/ThemeToggle.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteRoot = base ? `${base}/` : '/';
const sectionHref = (hash: string) => `${siteRoot}${hash}`;
const links = [
  { href: sectionHref('#features'), label: 'Features' },
  { href: sectionHref('#faq'), label: 'FAQ' },
  { href: `${base}/privacy`, label: 'Privacy' },
];
const cta = PLAY_LIVE ? { href: PLAY_URL, label: 'Get it on Google Play' } : null;
---
<header class="site-header">
  <div class="container-x flex items-center justify-between h-16">
    <a href={`${base}/`} class="flex items-center gap-3 no-underline" aria-label={`${APP_NAME} home`}>
      <img
        src={`${base}/images/logo.png`}
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 rounded-lg object-cover"
        decoding="async"
      />
      <span class="font-extrabold text-xl tracking-tight">{APP_NAME}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-6">
      {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:idle />
      {cta && <a href={cta.href} class="hidden sm:inline-flex btn btn-brass">{cta.label}</a>}
      <MobileNav client:idle links={links} />
    </div>
  </div>
</header>
